  <!-- ================= ROUTING & INTERACTIVE JAVASCRIPT ================= -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Multi-Page Hash Router
    const validPages = ['home', 'about', 'products', 'machinery', 'contact'];

    function routeToPage() {
      let hash = window.location.hash.replace('#', '') || 'home';
      if (!validPages.includes(hash)) {
        hash = 'home';
      }

      // Hide all page sections
      document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active'));

      // Show target page
      const targetSec = document.getElementById(`page-${hash}`);
      if (targetSec) {
        targetSec.classList.add('active');
      }

      // Update Navigation Active States
      document.querySelectorAll('.nav-item').forEach(item => {
        if (item.getAttribute('data-nav') === hash) {
          item.classList.add('bg-slate-100', 'text-brand-blue', 'font-bold');
          item.classList.remove('text-slate-600');
        } else {
          item.classList.remove('bg-slate-100', 'text-brand-blue', 'font-bold');
          item.classList.add('text-slate-600');
        }
      });

      // Update Breadcrumbs
      const breadcrumb = document.getElementById('currentBreadcrumb');
      if (breadcrumb) {
        breadcrumb.textContent = hash === 'machinery' ? 'Injection Moulding Machines' : hash.replace('-', ' ');
      }

      // Scroll to top
      window.scrollTo(0, 0);
      
      // Refresh icons if needed
      lucide.createIcons();
    }

    window.addEventListener('hashchange', routeToPage);
    window.addEventListener('DOMContentLoaded', routeToPage);

    // Mobile Drawer Toggle
    const mobileMenuToggle = document.getElementById('mobileMenuToggle');
    const mobileDrawer = document.getElementById('mobileDrawer');
    mobileMenuToggle.addEventListener('click', () => {
      mobileDrawer.classList.toggle('hidden');
    });

    function closeDrawer() {
      mobileDrawer.classList.add('hidden');
    }

    document.querySelectorAll('.mobile-nav-item').forEach(link => {
      link.addEventListener('click', closeDrawer);
    });

    // Catalog Filter
    function filterCatalog(category) {
      document.querySelectorAll('.cat-btn').forEach(btn => {
        btn.classList.remove('bg-brand-navy', 'text-white');
        btn.classList.add('bg-slate-200', 'text-slate-700');
      });
      event.target.classList.add('bg-brand-navy', 'text-white');
      event.target.classList.remove('bg-slate-200', 'text-slate-700');

      const cards = document.querySelectorAll('.catalog-card');
      cards.forEach(card => {
        if (category === 'all' || card.classList.contains(category)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Modal Control
    function openRfqModal(itemName) {
      document.getElementById('modalItemName').value = itemName || 'General Industrial Solution';
      document.getElementById('rfqModal').classList.remove('hidden');
      document.getElementById('rfqModal').classList.add('flex');
    }

    function closeRfqModal() {
      document.getElementById('rfqModal').classList.add('hidden');
      document.getElementById('rfqModal').classList.remove('flex');
    }

    // Modal Form Submission to WhatsApp
    function handleModalSubmit(e) {
      e.preventDefault();
      const item = document.getElementById('modalItemName').value;
      const name = document.getElementById('modalCustomerName').value;
      const phone = document.getElementById('modalCustomerPhone').value;
      const notes = document.getElementById('modalNotes').value;

      const message = `*Jyoti Industrial Solution - RFQ Request*%0A%0A*Item:* ${item}%0A*Customer:* ${name}%0A*Phone:* ${phone}%0A*Notes:* ${notes || 'N/A'}`;
      
      closeRfqModal();
      window.open(`https://wa.me/917891101658?text=${message}`, '_blank');
    }

    // Contact Form Direct Submission
    function handleContactSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('cName').value;
      const phone = document.getElementById('cPhone').value;
      const domain = document.getElementById('cDomain').value;
      const loc = document.getElementById('cLocation').value;
      const msg = document.getElementById('cMessage').value;

      const fullMessage = `*New Inquiry for Jyoti Industrial Solution*%0A%0A*Company / Client:* ${name}%0A*Contact:* ${phone}%0A*Domain:* ${domain}%0A*Plant Location:* ${loc || 'Not Specified'}%0A*Requirement:* ${msg || 'Direct Inquiry'}`;
      window.open(`https://wa.me/917891101658?text=${fullMessage}`, '_blank');
    }

    function sendViaMail() {
      const name = document.getElementById('cName').value;
      const domain = document.getElementById('cDomain').value;
      const msg = document.getElementById('cMessage').value;
      const subject = encodeURIComponent(`Quotation Request: ${domain} - ${name}`);
      const body = encodeURIComponent(`Client Name: ${name}\nRequirement Domain: ${domain}\n\nDetails:\n${msg}`);
      window.location.href = `mailto:jyotiindustrialsolution@gmail.com?subject=${subject}&body=${body}`;
    }

    // Copy GSTIN Function
    function copyGst() {
      const gst = "08CBWPG8529P1ZA";
      navigator.clipboard.writeText(gst).then(() => {
        const btn = document.getElementById('copyGstBtn');
        btn.innerHTML = `<i data-lucide="check" class="w-3.5 h-3.5 text-emerald-600"></i> GSTIN Copied!`;
        lucide.createIcons();
        setTimeout(() => {
          btn.innerHTML = `<i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy GSTIN`;
          lucide.createIcons();
        }, 2000);
      });
    }

    // Copy Address Function
    function copyAddress() {
      const addr = "Plot No. J-751, Riico Indl. Area, Phase-II, Bhiwadi, Khairthal-Tijara (Raj.) 301019";
      navigator.clipboard.writeText(addr).then(() => {
