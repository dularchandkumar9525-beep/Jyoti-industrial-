  <script>
    // Multi-page Hash Router
    const validPages = ['home', 'about', 'products', 'machinery', 'contact'];

    function routeToPage() {
      let hash = window.location.hash.replace('#', '') || 'home';
      if (!validPages.includes(hash)) {
        hash = 'home';
      }

      // Hide all pages
      document.querySelectorAll('.page-section').forEach(p => p.classList.remove('active'));

      // Show active page
      const current = document.getElementById(`page-${hash}`);
      if (current) current.classList.add('active');

      // Update Nav
      document.querySelectorAll('.nav-link').forEach(link => {
        if (link.getAttribute('data-nav') === hash) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });

      // Update Breadcrumb
      const bc = document.getElementById('breadcrumbCurrent');
      if (bc) {
        bc.textContent = hash === 'machinery' ? 'Used Machinery' : hash.charAt(0).toUpperCase() + hash.slice(1);
      }

      window.scrollTo(0, 0);
    }

    window.addEventListener('hashchange', routeToPage);
    window.addEventListener('DOMContentLoaded', routeToPage);

    // Mobile Menu Toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobileDropdown');
      menu.classList.toggle('open');
    }

    // RFQ Modal Controls
    function openRfqModal(item) {
      document.getElementById('modalItemName').value = item || 'General Inquiry';
      document.getElementById('rfqModal').classList.add('open');
    }

    function closeRfqModal() {
      document.getElementById('rfqModal').classList.remove('open');
    }

    // Submit Handlers (Send to WhatsApp)
